{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: g++.exe Debug Attivo",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\Program Files\\msys64\\ucrt64\\bin\\gdb.exe", // percorso aggiornato
            "setupCommands": [
                {
                    "description": "Abilita la stampa formattata per gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Imposta la sintassi di disassemblamento su Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++.exe build active file" // si collega al task precedente
        }
    ]
}